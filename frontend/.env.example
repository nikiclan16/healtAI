# mock = datos simulados en el navegador (demo, sin backend)
# http = backend real (FastAPI)
VITE_API_MODE=mock
VITE_API_BASE_URL=http://localhost:8000

# Autenticación real contra el backend (usuarios y roles creados en /admin) aunque el
# resto siga simulado. Ponerlo en .env.local para uso personal.
# VITE_AUTH_MODE=http
