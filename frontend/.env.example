# SOLO DESARROLLO. mock = datos simulados en el navegador (sin backend); http = backend real.
# Las compilaciones de producción (npm run build) ignoran esto y usan SIEMPRE el backend real:
# los servicios simulados, el letrero "MODO DEMO" y los usuarios de prueba no se incluyen.
VITE_API_MODE=mock
# En desarrollo la API está en http://localhost:8000. En producción, déjelo vacío si la API se
# sirve bajo el mismo dominio, o defina aquí la URL pública (https://...).
VITE_API_BASE_URL=http://localhost:8000

# Autenticación real contra el backend (usuarios y roles creados en /admin) aunque el
# resto siga simulado. Ponerlo en .env.local para uso personal.
# VITE_AUTH_MODE=http
