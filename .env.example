# Copie este archivo a .env (no se sube a git) y cambie TODOS los valores de ejemplo.
POSTGRES_USER=healthai
POSTGRES_PASSWORD=cambie_esta_contrasena
POSTGRES_DB=healthai
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=8000
# Clave para firmar los tokens (mínimo 32 caracteres, aleatoria). Ej.: openssl rand -hex 32
SECRET_KEY=cambie_esta_clave_larga_y_aleatoria_de_32_caracteres_o_mas
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Administrador inicial: se crea al arrancar solo si no existe ningún admin activo.
# Contraseña: mínimo 10 caracteres, con letras y números.
ADMIN_EMAIL=admin@cuc.test
ADMIN_PASSWORD=cambie_esta_contrasena_1

# Modelo. Producción: deje las dos líneas siguientes SIN definir (se exige backend/model_artifacts/model.json).
# Desarrollo: el modelo de prueba (NO clínico) permite probar el flujo completo.
MODEL_ARTIFACT_PATH=model_artifacts/model.placeholder.json
ALLOW_PLACEHOLDER_MODEL=true
