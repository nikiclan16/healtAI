# Copie a .env.production (en la raíz del repo, en el servidor) y complete TODOS los valores.
# No se sube a git. Permisos recomendados: chmod 600 .env.production

# Base de datos (la creada con deploy/setup-db.sh)
DATABASE_URL=postgresql+psycopg://healthai:CONTRASENA_DE_LA_BD@127.0.0.1:5432/healthai

# Firma de tokens: aleatoria, mínimo 32 caracteres.  openssl rand -hex 32
SECRET_KEY=

# Mismo dominio para front y API: el navegador no hace peticiones de otro origen.
CORS_ORIGINS=https://healtai.jmdatalabs.co

# Puerto local de la API (debe coincidir con deploy/nginx/healtai.jmdatalabs.co.conf)
BACKEND_PORT=8010

# Administrador inicial: se crea una sola vez si no hay ningún admin. Contraseña: 10+ caracteres con letras y números.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# NO definir MODEL_ARTIFACT_PATH, ALLOW_PLACEHOLDER_MODEL ni ENABLE_DOCS:
# producción exige backend/model_artifacts/model.json y mantiene /docs cerrado.
